{
  "name": "@jjp00/rdlc-designer-mcp",
  "version": "0.8.0",
  "description": "Servidor MCP (stdio) para crear y editar informes RDLC/RDL de Business Central desde un agente",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rdlc",
    "rdl",
    "business-central",
    "report"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJP00/rdlc-report-designer.git",
    "directory": "packages/rdlc-mcp"
  },
  "bin": {
    "rdlc-mcp": "dist/server.mjs"
  },
  "files": [
    "dist/server.mjs",
    "resources/rdl2016/ReportDefinition2016.xsd",
    "resources/rdl2016/DefaultFontFamily.xsd",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^12.0.1",
    "chokidar": "^5.0.0",
    "libxml2-wasm": "^0.7.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xml-trueformat": "^0.9.5",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}

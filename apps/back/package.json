{
  "name": "@rdlc-designer/back",
  "version": "0.8.2",
  "private": true,
  "description": "Electron main + NestJS — el hexágono (dominio, aplicación, presentación, infraestructura)",
  "author": "RDLC Report Designer",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mcp": "node scripts/build-mcp.mjs",
    "mcp": "node out/mcp/server.mjs",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "e2e": "pnpm build:e2e && playwright test",
    "e2e:run": "playwright test",
    "build:e2e": "electron-vite build --mode e2e",
    "bench": "electron-vite build && node scripts/bench.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir --publish never",
    "dist:portable": "electron-vite build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@rdlc-designer/contracts": "workspace:*",
    "@rdlc-designer/i18n": "workspace:*",
    "chokidar": "^5.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xml-trueformat": "^0.9.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "fast-xml-parser": "^5.11.2",
    "libxml2-wasm": "^0.7.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}

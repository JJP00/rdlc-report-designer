{
  "name": "rdlc-report-designer",
  "version": "0.1.0",
  "private": true,
  "description": "Editor visual para layouts de informes RDLC de Business Central",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "e2e": "pnpm --filter @rdlc-designer/back e2e",
    "dist": "pnpm --filter @rdlc-designer/back dist",
    "dist:dir": "pnpm --filter @rdlc-designer/back dist:dir",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,jsx,cjs,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,jsx,cjs,css,html}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": ">=3.4.17"
    }
  }
}
